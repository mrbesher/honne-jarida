{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "honne-jarida",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-08",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "honne-jarida",
      "database_id": "5cf3a953-9f7b-44fe-96e3-df68ee35f0fd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUP",
      "bucket_name": "honne-jarida-backup"
    }
  ],
  "triggers": {
    "crons": ["0 9 * * 1"]
  }
}
